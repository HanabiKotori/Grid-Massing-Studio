# 高德开放平台 Web 服务 Key（用于实时天气）
VITE_AMAP_KEY=aef5f5f85f6e8b932b825f70c04439c9

# 多人漫游 Node WebSocket 服务地址
# 本地开发：
VITE_MULTIPLAYER_WS_URL=ws://localhost:3010
# 生产环境（Nginx 反向代理 /ws）示例：
# VITE_MULTIPLAYER_WS_URL=wss://47.95.122.233:5173/ws

# 云端存储开关
# false（默认）：使用浏览器 IndexedDB 自动保存与恢复
# true：登录 dataService 后使用云端存储，自动保存写入所选存储位置
VITE_CLOUD_STORAGE_ENABLED=false

# dataService 统一通过同源 /api 访问：
#   本地：vite.config.ts server.proxy -> 127.0.0.1:3020
#   生产：Nginx /api/ -> 127.0.0.1:3020
# 不需要设置 VITE_DATA_SERVICE_URL
