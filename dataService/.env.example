# 云存储服务监听
PORT=3020
HOST=0.0.0.0

# MySQL 数据库
DB_HOST=101.201.112.253
DB_PORT=3306
DB_USER=grid-massing-data
DB_PASSWORD=change-me
DB_NAME=grid-massing-data
DB_POOL=10

# 登录令牌：请改成一串足够长的随机字符串，修改后已登录用户需要重新登录
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES=7d

# 单个场景 JSON 上限（MB），含 Logo / 底图时需调大
MAX_SCENE_MB=40

# 允许的前端来源，逗号分隔；留空表示允许所有来源
# 生产环境建议填写实际站点，例如 https://your-domain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
