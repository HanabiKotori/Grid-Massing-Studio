{
  "ssh": {
    "host": "your-server-ip",
    "port": 22,
    "username": "root",
    "password": "在这里填写服务器密码"
  },
  "web": {
    "remotePath": "/www/wwwroot/your-site",
    "buildCommand": "npm run build",
    "distDir": "dist",
    "owner": "www:www",
    "keep": [
      ".user.ini",
      ".htaccess"
    ],
    "nginx": {
      "path": "/www/server/panel/vhost/nginx/extension/your-site/proxy.conf",
      "apiTarget": "http://127.0.0.1:3020",
      "wsTarget": "http://127.0.0.1:3010",
      "reloadCommand": "systemctl reload nginx"
    }
  },
  "multiplayer": {
    "remotePath": "/www/wwwroot/多人",
    "localDir": "gameService",
    "files": [
      "server.mjs",
      "package.json",
      "package-lock.json"
    ],
    "uploadEnv": false,
    "pm2Name": "server",
    "entry": "server.mjs",
    "installDeps": true,
    "restartMode": "auto"
  },
  "data": {
    "remotePath": "/www/wwwroot/数据",
    "localDir": "dataService",
    "include": [
      "server.mjs",
      "schema.sql",
      "package.json",
      "package-lock.json",
      "src"
    ],
    "uploadEnv": true,
    "pm2Name": "dataService",
    "entry": "server.mjs",
    "installDeps": true,
    "restartMode": "auto",
    "healthUrl": "http://127.0.0.1:3020/api/health"
  }
}
