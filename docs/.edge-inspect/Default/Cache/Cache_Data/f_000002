: 1px 5px;\r\n  border-radius: 4px;\r\n  background: rgba(255, 255, 255, 0.9);\r\n  border: 1px solid var(--line);\r\n  color: var(--ink-2);\r\n  font-size: 10px;\r\n  font-variant-numeric: tabular-nums;\r\n  white-space: nowrap;\r\n  pointer-events: none;\r\n  box-shadow: 0 2px 6px -4px rgba(20, 22, 28, 0.5);\r\n}\r\n\r\n/* 指北罗盘：视图工具下方 */\r\n.compass {\r\n  position: absolute;\r\n  top: 138px;\r\n  left: 20px;\r\n  z-index: 10;\r\n  width: 64px;\r\n  height: 64px;\r\n  display: grid;\r\n  place-items: center;\r\n  background: rgba(255, 255, 255, 0.86);\r\n  backdrop-filter: blur(14px) saturate(150%);\r\n  border: 1px solid var(--line);\r\n  border-radius: 50%;\r\n  box-shadow: var(--shadow-sm);\r\n  pointer-events: none;\r\n  user-select: none;\r\n}\r\n\r\n.compass svg {\r\n  display: block;\r\n  width: 62px;\r\n  height: 62px;\r\n}\r\n\r\n.compass-tick {\r\n  stroke: var(--line-strong);\r\n  stroke-width: 1;\r\n}\r\n\r\n.compass-tick-major {\r\n  stroke: var(--ink-3);\r\n  stroke-width: 1.4;\r\n}\r\n\r\n.compass-north {\r\n  fill: var(--accent);\r\n}\r\n\r\n.compass-south {\r\n  fill: #c6cad2;\r\n}\r\n\r\n.compass-n {\r\n  fill: var(--ink);\r\n  font-size: 8px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.02em;\r\n}\r\n\r\n/* ---------- 第一人称漫游 ---------- */\r\n\r\n.tool-sep {\r\n  width: 1px;\r\n  height: 18px;\r\n  margin: 0 3px;\r\n  align-self: center;\r\n  background: var(--line-strong);\r\n}\r\n\r\n.hidden-file {\r\n  display: none;\r\n}\r\n\r\n/* 模拟时间 */\r\n.sim-clock {\r\n  position: absolute;\r\n  top: 20px;\r\n  left: 238px;\r\n  z-index: 12;\r\n  width: 300px;\r\n  height: 59px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: space-between;\r\n  gap: 3px;\r\n  padding: 8px 12px;\r\n  background: rgba(255, 255, 255, 0.86);\r\n  backdrop-filter: blur(14px) saturate(150%);\r\n  border: 1px solid var(--line);\r\n  border-radius: 11px;\r\n  box-shadow: var(--shadow-sm);\r\n}\r\n\r\n.sim-clock-head {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 7px;\r\n  color: var(--warn);\r\n}\r\n\r\n.sim-clock.night .sim-clock-head {\r\n  color: #6f87b8;\r\n}\r\n\r\n.sim-clock-head b {\r\n  font-size: 15px;\r\n  font-weight: 600;\r\n  color: var(--ink);\r\n  font-variant-numeric: tabular-nums;\r\n  letter-spacing: 0.02em;\r\n}\r\n\r\n.sim-play {\r\n  margin-left: auto;\r\n  width: 24px;\r\n  height: 24px;\r\n  display: grid;\r\n  place-items: center;\r\n  border-radius: 6px;\r\n  color: var(--ink-2);\r\n}\r\n\r\n.sim-play:hover {\r\n  background: var(--surface-2);\r\n  color: var(--ink);\r\n}\r\n\r\n.sim-track {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 7px;\r\n}\r\n\r\n.sim-track span {\r\n  flex: none;\r\n  font-size: 9.5px;\r\n  color: var(--ink-3);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n\r\n.sim-range {\r\n  flex: 1;\r\n  appearance: none;\r\n  -webkit-appearance: none;\r\n  height: 14px;\r\n  background: transparent;\r\n  outline: none;\r\n  cursor: pointer;\r\n}\r\n\r\n.sim-range::-webkit-slider-runnable-track {\r\n  height: 3px;\r\n  border-radius: 99px;\r\n  background: linear-gradient(\r\n    to right,\r\n    var(--accent) var(--fill),\r\n    var(--line-strong) var(--fill)\r\n  );\r\n}\r\n\r\n.sim-range::-webkit-slider-thumb {\r\n  -webkit-appearance: none;\r\n  width: 12px;\r\n  height: 12px;\r\n  margin-top: -4.5px;\r\n  border-radius: 50%;\r\n  background: var(--accent);\r\n  border: 2px solid #fff;\r\n  box-shadow: 0 1px 4px rgba(20, 22, 28, 0.3);\r\n}\r\n\r\n.sim-range::-moz-range-track {\r\n  height: 3px;\r\n  border-radius: 99px;\r\n  background: linear-gradient(\r\n    to right,\r\n    var(--accent) var(--fill),\r\n    var(--line-strong) var(--fill)\r\n  );\r\n}\r\n\r\n.sim-range::-moz-range-thumb {\r\n  width: 8px;\r\n  height: 8px;\r\n  border-radius: 50%;\r\n  background: var(--accent);\r\n  border: 2px solid #fff;\r\n}\r\n\r\n/* 低画质：关闭毛玻璃模糊与半透明合成，降低低端 GPU 负担 */\r\n.app.quality-low * {\r\n  backdrop-filter: none !important;\r\n}\r\n\r\n.app.quality-low .bra