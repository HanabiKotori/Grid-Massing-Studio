.toast-enter-from,\r\n.toast-leave-to {\r\n  opacity: 0;\r\n  transform: translate(-50%, -8px);\r\n}\r\n\r\n/* ---------- 响应式 ---------- */\r\n\r\n@media (max-width: 1180px) {\r\n  .panel {\r\n    width: 300px;\r\n  }\r\n  .dock-wrap {\r\n    right: 336px;\r\n  }\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .panel {\r\n    top: auto;\r\n    bottom: 96px;\r\n    right: 12px;\r\n    left: 12px;\r\n    width: auto;\r\n    max-height: 46vh;\r\n  }\r\n  .dock-wrap {\r\n    right: 0;\r\n    bottom: 12px;\r\n  }\r\n  .welcome {\r\n    left: 50%;\r\n    top: 40%;\r\n    width: calc(100% - 32px);\r\n    max-width: 400px;\r\n  }\r\n  .legend {\r\n    display: none;\r\n  }\r\n}\r\n\r\n/* ---------- 合并标记与弹窗 ---------- */\r\n\r\n.gdot {\r\n  display: inline-block;\r\n  width: 7px;\r\n  height: 7px;\r\n  border-radius: 2px;\r\n  margin-right: 5px;\r\n  vertical-align: 1px;\r\n}\r\n\r\n.merge-actions {\r\n  display: flex;\r\n  gap: 6px;\r\n  flex: none;\r\n}\r\n\r\n.modal-mask {\r\n  position: absolute;\r\n  inset: 0;\r\n  z-index: 40;\r\n  display: grid;\r\n  place-items: center;\r\n  background: rgba(24, 26, 30, 0.26);\r\n  backdrop-filter: blur(3px);\r\n}\r\n\r\n.modal {\r\n  width: min(430px, calc(100% - 40px));\r\n  padding: 20px;\r\n  background: #fff;\r\n  border: 1px solid var(--line);\r\n  border-radius: 16px;\r\n  box-shadow: 0 26px 60px -22px rgba(20, 22, 28, 0.5);\r\n  animation: dock-in 0.2s cubic-bezier(0.2, 0.8, 0.3, 1);\r\n}\r\n\r\n.modal h3 {\r\n  margin: 0 0 8px;\r\n  font-size: 15px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.01em;\r\n}\r\n\r\n.modal p {\r\n  margin: 0 0 18px;\r\n  font-size: 12.5px;\r\n  line-height: 1.7;\r\n  color: var(--ink-2);\r\n}\r\n\r\n.modal-actions {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n  gap: 8px;\r\n}\r\n\r\n.venue-view {\r\n  display: flex;\r\n  gap: 6px;\r\n  margin-top: 10px;\r\n}\r\n\r\n.vtoggle {\r\n  flex: 1;\r\n  height: 30px;\r\n  border-radius: 8px;\r\n  border: 1px solid var(--line);\r\n  background: #f