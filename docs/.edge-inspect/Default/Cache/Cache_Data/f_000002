 flex: 1;\r\n  width: auto;\r\n  min-width: 0;\r\n}\r\n\r\n.name-edit {\r\n  flex: none;\r\n  width: 18px;\r\n  height: 18px;\r\n  padding: 0;\r\n  display: grid;\r\n  place-items: center;\r\n  border: 1px solid var(--line);\r\n  border-radius: 4px;\r\n  background: transparent;\r\n  color: var(--ink-3);\r\n  font-size: 11px;\r\n  line-height: 1;\r\n  cursor: pointer;\r\n}\r\n\r\n.name-edit:hover {\r\n  color: var(--accent-ink);\r\n  border-color: var(--line-strong);\r\n  background: rgba(0, 0, 0, 0.035);\r\n}\r\n\r\n.name-input {\r\n  width: 100%;\r\n  height: 21px;\r\n  padding: 0 5px;\r\n  border: 1px solid var(--accent);\r\n  border-radius: 5px;\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  color: var(--ink);\r\n  outline: none;\r\n  background: #fff;\r\n  box-shadow: 0 0 0 3px rgba(47, 95, 224, 0.1);\r\n}\r\n\r\n/* 3D 名称气泡 */\r\n.booth-label {\r\n  padding: 3px 8px;\r\n  border-radius: 6px;\r\n  background: rgba(255, 255, 255, 0.95);\r\n  border: 1px solid var(--line);\r\n  box-shadow: 0 6px 16px -10px rgba(20, 22, 28, 0.7);\r\n  font-size: 11px;\r\n  font-weight: 500;\r\n  color: var(--ink);\r\n  letter-spacing: 0.01em;\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  max-width: 150px;\r\n  pointer-events: none;\r\n  user-select: none;\r\n}\r\n\r\n.coord.snap {\r\n  border-color: #c9d6ff;\r\n  background: var(--accent-soft);\r\n}\r\n\r\n.coord.snap b,\r\n.coord.snap span,\r\n.coord.snap i {\r\n  color: var(--accent-ink);\r\n}\r\n\r\n/* ---------- 基础设施 ---------- */\r\n\r\n.swatch.infra {\r\n  background: var(--accent);\r\n  border-color: var(--accent);\r\n}\r\n\r\n.infra-add {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, 1fr);\r\n  gap: 6px;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.infra-add .btn {\r\n  width: 100%;\r\n  padding: 0 4px;\r\n  font-size: 11px;\r\n}\r\n\r\n.infra-subhead {\r\n  margin: 12px 0 6px;\r\n  font-size: 10px;\r\n  letter-spacing: 0.08em;\r\n  color: var(--ink-3);\r\n}\r\n\r\n.infra-fixed